(* Higgs: physical scalars  *)
  S[1] == {
    ClassName        -> H1,
    Indices          -> {Index[SU2D]},
    SelfConjugate    -> False,
    Mass             -> 0,
    FullName         -> "light",
    QuantumNumbers   -> {Y -> 1/2}
  },

(* Higgs tilde: unphysical scalars  *)
  S[10] == {
    ClassName        -> H1Tilde,
    Indices          -> {Index[SU2D]},
    SelfConjugate    -> False,
    Mass             -> 0,
    QuantumNumbers   -> {Y -> -1/2},
    Unphysical       -> True,
    Definitions      -> {H1Tilde[i_] :> Eps[i,j] H1bar[j]}
  }
};

