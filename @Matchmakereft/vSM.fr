(* ************************** *)
(* *****  Information   ***** *)
(* ************************** *)

M$ModelName = "vSM";

M$Information = {
  Authors      -> {"Wen-Feng Duan"}, 
  Version      -> "1.0",
  Date         -> "08. 2026",
  Institutions -> {"Institute of Particle Physics, CCNU"},
  Emails       -> {"dufewe@mails.ccnu.edu.cn"}
};

FeynmanGauge = True;

(* ************************** *)
(* *****  Gauge groups  ***** *)
(* ************************** *)

M$GaugeGroups = {
  U1Y  == { 
    Abelian          -> True,  
    CouplingConstant -> g1, 
    GaugeBoson       -> BT, 
    Charge           -> Y
  },
  SU2L == { 
    Abelian           -> False, 
    CouplingConstant  -> g2, 
    GaugeBoson        -> WT, 
    StructureConstant -> fsu2, 
    Representations   -> {{Ta,SU2D}}
  },
  SU3C == { 
    Abelian           -> False, 
    CouplingConstant  -> gs, 
    GaugeBoson        -> GT,
    StructureConstant -> fsu3, 
    Representations   -> {{T,Colour}}
  } 
};

(* ************************** *)
(* *****    Indices     ***** *)
(* ************************** *)

IndexRange[Index[SU2W      ]] = Range[3]; 
IndexRange[Index[SU2D      ]] = Range[2];
IndexRange[Index[Gluon     ]] = Range[8];
IndexRange[Index[Colour    ]] = Range[3]; 
IndexRange[Index[Generation]] = Range[3];

IndexStyle[SU2W,       n];
IndexStyle[SU2D,       l];
IndexStyle[Gluon,      a];
IndexStyle[Colour,     m];
IndexStyle[Generation, fl];

