(* *****   Parameters   ***** *)
(* ************************** *)

M$Parameters = {

  (* Internal Parameters *)
  g1 == {
    ParameterType    -> Internal,
    ComplexParameter -> False
  },
  g2 == {
    ParameterType    -> Internal,
    ComplexParameter -> False
  },
  gs == {
    ParameterType    -> Internal,
    ComplexParameter -> False
  },

  lambda1 == {
    ParameterType    -> Internal,
    ComplexParameter -> False
  },
  mH11 == {
    ParameterType    -> Internal,
    ComplexParameter -> False
  },

  YU1 == {
    ParameterType    -> Internal,
    Indices          -> {Index[Generation], Index[Generation]},
    ComplexParameter -> True
  },
  YD1 == {
    ParameterType    -> Internal,
    Indices          -> {Index[Generation], Index[Generation]},
    ComplexParameter -> True
  },
  Yv1 == {
    ParameterType    -> Internal,
    Indices          -> {Index[Generation], Index[Generation]},
    ComplexParameter -> True
  },
  YE1 == {
    ParameterType    -> Internal,
    Indices          -> {Index[Generation], Index[Generation]},
    ComplexParameter -> True
  }
};


(* ************************** *)
(* *****   Lagrangian   ***** *)
(* ************************** *)

BFM = {BT[mu_] -> BT[mu] + BTQuantum[mu], WT[mu_, ii_] -> WT[mu, ii] + WTQuantum[mu, ii], GT[mu_, aa_] -> GT[mu, aa] + GTQuantum[mu, aa]};

LGauge := Block[{mu,nu,ii,aa}, 
  -1/4 FS[BT,mu,nu] FS[BT,mu,nu] - 1/4 FS[WT,mu,nu,ii] FS[WT,mu,nu,ii] - 1/4 FS[GT,mu,nu,aa] FS[GT,mu,nu,aa]
]/.BFM;

LFermions := Block[{mu}, 
  I*(QLbar.Ga[mu].DC[QL, mu] + URbar.Ga[mu].DC[UR, mu] + DRbar.Ga[mu].DC[DR, mu] + LLbar.Ga[mu].DC[LL, mu] + NRbar.Ga[mu].DC[NR, mu] + ERbar.Ga[mu].DC[ER, mu])
]/.BFM;

LHiggs := Block[{ii,mu},
  DC[H1bar[ii],mu] DC[H1[ii],mu] - mH11^2 H1bar[ii] H1[ii] - lambda1 H1bar[ii] H1[ii] H1bar[jj] H1[jj] / 2
]/.BFM; 

LYukawa := Block[{sp1,ii,cc,ff1,ff2,yuk},
  yuk = - YU1[ff1, ff2] QLbar[sp1, ii, ff1, cc].UR[sp1, ff2, cc] H1Tilde[ii] - YD1[ff1, ff2] QLbar[sp1, ii, ff1, cc].DR[sp1, ff2, cc] H1[ii] - Yv1[ff1, ff2] LLbar[sp1, ii, ff1].NR[sp1, ff2] H1Tilde[ii] - YE1[ff1, ff2] LLbar[sp1, ii, ff1].ER[sp1, ff2] H1[ii];
  yuk + HC[yuk]
];

LGhost := Block[{aa,LGh1,LGh2,LGhs,mu},
  (* Pure gauge piece *) 	
  LGh1 = - ghBTbar.DC[(DC[ghBT,mu]/.BFM),mu];
  LGh2 = - ghWTbar[aa].DC[(DC[ghWT[aa],mu]/.BFM),mu];
  LGhs = - ghGTbar[aa].DC[(DC[ghGT[aa],mu]/.BFM),mu];
  ExpandIndices[LGhs + LGh1 + LGh2, FlavorExpand -> SU2W]
];

LGaugeFixing := Block[{aa,LGFs,LGF2,LGF1,mu,nu},
  LGF1 = - DC[BTQuantum[mu],mu] DC[BTQuantum[nu],nu] / 2;
  LGF2 = - DC[WTQuantum[mu,aa],mu] DC[WTQuantum[nu,aa],nu] / 2;
  LGFs = - DC[GTQuantum[mu,aa],mu] DC[GTQuantum[nu,aa],nu] / 2;
  ExpandIndices[LGF1 + LGF2 + LGFs]
];

LvSM := LGauge + LFermions + LHiggs + LYukawa + LGhost + LGaugeFixing;