id diags2 = (1)*(Evect(p1,mu99))*(Evect(p2,mu97))*(I*prop(k1-p1,mH22)*deltaF(l1,l2))*(I*prop(k1,mH22)*deltaF(l3,l4))*((I/2)*g1*deltaF(l1,l4)*Mom(k1-p1,mu99)-(I/2)*g1*deltaF(l1,l4)*Mom(-k1,mu99))*((I/2)*g1*deltaF(l3,l2)*Mom(k1,mu97)-(I/2)*g1*deltaF(l3,l2)*Mom(-k1+p1,mu97));

