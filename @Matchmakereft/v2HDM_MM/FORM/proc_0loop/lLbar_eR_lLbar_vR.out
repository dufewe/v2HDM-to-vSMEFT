    esfull(1)=YE2[fl99,fl97]*Yv2[fl95,fl93];
    esfull(2)=YE2[fl95,fl97]*Yv2[fl99,fl93];
    esfull(3)=G[gam[y95,FIVE,y93]*gam[y99,FIVE,y97]*I*mH22^(-2)*esfull(1) + 
   gam[y95,FIVE,y93]*gam[y99,y97]*I*mH22^(-2)*esfull(1) + gam[y95,FIVE,y97]*
   gam[y99,FIVE,y93]*I*mH22^(-2)*esfull(2) + gam[y95,FIVE,y97]*gam[y99,y93]*I*
   mH22^(-2)*esfull(2) + gam[y95,y93]*gam[y99,FIVE,y97]*I*mH22^(-2)*esfull(1)
    + gam[y95,y93]*gam[y99,y97]*I*mH22^(-2)*esfull(1) + gam[y95,y97]*gam[y99,
   FIVE,y93]*I*mH22^(-2)*esfull(2) + gam[y95,y97]*gam[y99,y93]*I*mH22^(-2)*
   esfull(2)];

