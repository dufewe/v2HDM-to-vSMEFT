    esfull(1)=YD2bar[fl97,fl99]*YU2bar[fl93,fl95];
    esfull(2)=YD2bar[fl93,fl99]*YU2bar[fl97,fl95];
    esfull(3)=G[gam[y95,FIVE,y93]*gam[y99,FIVE,y97]*I*mH22^(-2)*esfull(1) - 
   gam[y95,FIVE,y93]*gam[y99,y97]*I*mH22^(-2)*esfull(1) - gam[y95,y93]*gam[y99
   ,FIVE,y97]*I*mH22^(-2)*esfull(1) + gam[y95,y93]*gam[y99,y97]*I*mH22^(-2)*
   esfull(1)];
    esfull(4)=G[gam[y95,FIVE,y97]*gam[y99,FIVE,y93]*I*mH22^(-2)*esfull(2) - 
   gam[y95,FIVE,y97]*gam[y99,y93]*I*mH22^(-2)*esfull(2) - gam[y95,y97]*gam[y99
   ,FIVE,y93]*I*mH22^(-2)*esfull(2) + gam[y95,y97]*gam[y99,y93]*I*mH22^(-2)*
   esfull(2)];

