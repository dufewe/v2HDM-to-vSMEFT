Cell[BoxData["\<\"The Lagrangian contains terms of lower power than dimension \
4. Defining effective couplings and assuming these terms to be dimension 4. \
Use 'PrintEffectiveCouplings' and 'ReplaceEffectiveCouplings' to recover \
explicit expressions.\"\>"], "Echo",
 CellChangeTimes->{
  4.002279904296631*^9},ExpressionUUID->"c0078889-11e9-4f50-b0db-\
65de944bdfe3"]
}, Open  ]],

