Cell[BoxData[
 InterpretationBox[
  RowBox[{
   TagBox[
    StyleBox[
     SubscriptBox[
      TagBox[
       FormBox["\<\"C\"\>",
        StandardForm],
       StandardForm,
       Editable->True], 
      TemplateBox[{
        TemplateBox[{
          TagBox[
           FormBox["H1", StandardForm], StandardForm, Editable -> True], "2"},
          "Superscript", SyntaxForm -> SuperscriptBox]},
       "RowDefault"]], "StandardForm"],
    Format[#, Matchete`NiceForm]& ], "\[InvisibleSpace]", "\<\" = \"\>", "\[InvisibleSpace]", 
   TagBox[
    StyleBox[
     RowBox[{"-", 
      SuperscriptBox["m11", "2"], "+", 
      RowBox[{"\[HBar]", 
       FractionBox["1", "\[Epsilon]"], 
       SuperscriptBox["m22", "2"], " ", 
       FormBox[
        StyleBox[
         RowBox[{"(", 
          RowBox[{
           RowBox[{"2", "lambda3"}], "+", "lambda4"}], ")"}],
         SpanSymmetric->False],
        StandardForm], " ", 
       FormBox[
        StyleBox[
         RowBox[{"(", 
          RowBox[{"1", "+", "\[Epsilon]", "+", 
           RowBox[{"\[Epsilon]", 
            FormBox[
             RowBox[{"Log", "[", 
              FractionBox[
               SuperscriptBox[
                OverscriptBox["\[Mu]", 
                 StyleBox["_",
                  FontWeight->Bold]], "2"], 
               SuperscriptBox["m22", "2"]], "]"}],
             StandardForm]}]}], ")"}],
         SpanSymmetric->False],
        StandardForm]}]}], "StandardForm"],
    Format[#, Matchete`NiceForm]& ]}],
  SequenceForm[
   Format[
    Matchete`Coupling[$CellContext`CH12, {}, 2], Matchete`NiceForm], " = ", 
   Format[-Matchete`Coupling[$CellContext`m11, {}, 1]^2 + 
    Matchete`hbar 
     Matchete`\[Epsilon]^(-1) (
      2 Matchete`Coupling[$CellContext`lambda3, {}, 0] + 
      Matchete`Coupling[$CellContext`lambda4, {}, 0]) 
     Matchete`Coupling[$CellContext`m22, {}, 0]^2 (1 + Matchete`\[Epsilon] + 
      Matchete`\[Epsilon] 
       Log[Matchete`\[Mu]bar2 
         Matchete`Coupling[$CellContext`m22, {}, 0]^(-2)]), 
    Matchete`NiceForm]],
  Editable->False]], "Print",
 CellChangeTimes->{3.9967013741612263`*^9, 3.996701689780726*^9, 
